generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Language {
  SO
  EN
}

enum Currency {
  USD
  SOS
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum SavingsGoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum FinancialGoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum NotificationType {
  BUDGET_ALERT
  SAVINGS_REMINDER
  GOAL_REMINDER
  SYSTEM
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  name              String
  email             String             @unique
  phone             String?            @unique
  password          String
  role              Role               @default(USER)
  preferredLanguage Language           @default(SO)
  preferredCurrency Currency           @default(USD)
  categories        Category[]
  transactions      Transaction[]
  budgets           Budget[]
  savingsGoals      SavingsGoal[]
  financialGoals    FinancialGoal[]
  notifications     Notification[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Category {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String?       @db.Uuid
  name         String
  type         CategoryType
  icon         String?
  isDefault    Boolean       @default(false)
  key          String?       @unique
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
  @@index([type, isDefault])
}

model Transaction {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @db.Uuid
  categoryId  String?         @db.Uuid
  type        TransactionType
  amount      Decimal         @db.Decimal(19, 4)
  currency    Currency
  title       String
  description String?
  date        DateTime
  user        User            @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
  @@index([categoryId])
  @@index([date])
  @@index([type])
  @@index([createdAt])
  @@index([userId, date])
}

model Budget {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  categoryId String?   @db.Uuid
  amount     Decimal   @db.Decimal(19, 4)
  currency   Currency
  month      Int
  year       Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, categoryId, month, year])
  @@index([userId])
  @@index([categoryId])
  @@index([month, year])
}

model SavingsGoal {
  id           String               @id @default(uuid()) @db.Uuid
  userId       String               @db.Uuid
  name         String
  targetAmount Decimal              @db.Decimal(19, 4)
  currentAmount Decimal            @default(0) @db.Decimal(19, 4)
  currency     Currency
  deadline     DateTime?
  description  String?
  status       SavingsGoalStatus    @default(ACTIVE)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  contributions SavingsContribution[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([userId])
  @@index([status])
}

model SavingsContribution {
  id           String      @id @default(uuid()) @db.Uuid
  savingsGoalId String     @db.Uuid
  amount       Decimal     @db.Decimal(19, 4)
  date         DateTime
  note         String?
  savingsGoal  SavingsGoal @relation(fields: [savingsGoalId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt    DateTime    @default(now())

  @@index([savingsGoalId])
  @@index([date])
}

model FinancialGoal {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @db.Uuid
  name          String
  targetAmount  Decimal             @db.Decimal(19, 4)
  currentAmount Decimal             @default(0) @db.Decimal(19, 4)
  currency      Currency
  deadline      DateTime?
  description   String?
  status        FinancialGoalStatus @default(ACTIVE)
  user          User                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([userId])
  @@index([status])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, isRead, createdAt])
}
